{
  "name": "pdm-frontend",
  "private": true,
  "version": "0.1.2",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --build --force && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "typecheck": "vue-tsc --build --force",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "gen:types": "openapi-typescript ../contracts/schemas/openapi.json -o src/api/generated.ts && prettier -w src/api/generated.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "echarts": "^5.6.0",
    "pinia": "^3.0.4",
    "vue": "^3.5.43",
    "vue-i18n": "^11.4.13",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/compiler-sfc": "^3.5.43",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.11.1",
    "jsdom": "^26.1.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.9",
    "typescript": "~5.8",
    "typescript-eslint": "^8.71.1",
    "vite": "^6.4.4",
    "vitest": "^3.2.7",
    "vue-tsc": "^2.2.12"
  }
}
