# Industrial Predictive Maintenance Platform: server settings (copied to backend\.env by install.ps1).
# Keep this file on the server only. It is never sent to browsers.

# PostgreSQL application database (not the production IoT database).
PDM_DATABASE_URL=postgresql+psycopg://pdm:CHANGE_ME@127.0.0.1:5432/pdm

# Local accounts and signed session cookies. Do not use "dev" on a shared network.
PDM_AUTH_MODE=local
# At least 32 random characters. install.ps1 generates one when this is left empty.
PDM_SECRET_KEY=
# Set to true only when the server is behind HTTPS.
PDM_COOKIE_SECURE=false

# Built browser client, served on the same port as the API.
PDM_STATIC_DIR=..\frontend\dist

# Data sources (simulated datasets ship with the package). Production sources in this file are
# skipped until PDM_PRODUCTION_DATA_APPROVED=true, which needs the user's explicit G4 approval.
PDM_DATASOURCES_FILE=..\deploy\datasources.simulated.json
PDM_PRODUCTION_DATA_APPROVED=false

# Local LLM is optional; configure the Ollama endpoint in the Assistant screen as an administrator.
PDM_LLM_ENABLED=false
